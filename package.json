{
  "name": "exp-loop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter '!@exp-loop/desktop' run build",
    "exploop": "pnpm build && node packages/cli/dist/index.js",
    "exploop:watch": "pnpm build && node packages/cli/dist/index.js watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "node packages/cli/dist/index.js watch",
    "lint": "eslint packages/*/src",
    "typecheck": "tsc -b",
    "desktop:prepare": "pnpm build && pnpm --filter @exp-loop/desktop prepare-sidecar",
    "desktop:dev": "pnpm desktop:prepare && pnpm --filter @exp-loop/desktop tauri:dev",
    "desktop:build": "pnpm desktop:prepare && pnpm --filter @exp-loop/desktop tauri:build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}

# exp-loop LLM configuration. Copy to .env and fill in real values.
# .env is gitignored. The CLI loads .env with override:true, so project-local
# values take precedence over shell-exported env vars.

# Auth token for the Anthropic-compatible endpoint.
ANTHROPIC_AUTH_TOKEN=your-token-here

# Base URL of an Anthropic-compatible API (omit to use the official Anthropic API).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model name to use for experience extraction (must be supported by your endpoint).
EXP_LOOP_LLM_MODEL=claude-sonnet-4-20250514

# Optional: tune the incremental extraction gate (watch command).
# EXP_LOOP_IDLE_MS=120000
# EXP_LOOP_MIN_DELTA_LINES=30
